@startuml BaoCao-SEQ-02-Auth-Login-ResetPassword
title SEQ 02 - Đăng nhập và khôi phục mật khẩu

actor User
participant "Frontend\n(authService)" as FE
participant "AuthController" as AC
participant "AuthService" as AS
participant "OtpService" as OS
participant "EmailService" as ES
database "ApplicationDbContext" as DB
participant "JwtService" as JS

group Đăng nhập
User -> FE: Nhập email/password
FE -> AC: POST /api/auth/login
AC -> AS: GetUserByEmailAsync(email)
AS -> DB: Query Users
DB --> AS: user/null
alt Sai email
  AS --> AC: null
  AC --> FE: 401
else Có user
  AS --> AC: user
  AC -> AS: CheckPasswordAsync(user, password)
  AS --> AC: true/false
  alt Sai password
    AC --> FE: 401
  else Đúng password
    AC -> DB: Update LastLoginAt
    AC -> JS: GenerateAccessToken(user)
    JS --> AC: JWT
    AC --> FE: 200 + token + user
  end
end
end

group Quên mật khẩu
User -> FE: Nhập email quên mật khẩu
FE -> AC: POST /api/auth/forgot-password
AC -> AS: GetUserByEmailAsync(email)
alt Không tồn tại email
  AC --> FE: 200 "Nếu email tồn tại, mã OTP sẽ được gửi."
else Tồn tại email
  AC -> OS: CreateAndSendOtpAsync(email, "forgot-password")
  OS -> DB: Insert OtpCode
  OS -> ES: SendEmailAsync(...)
  AC --> FE: 200
end

User -> FE: OTP + newPassword
FE -> AC: POST /api/auth/reset-password
AC -> OS: VerifyOtpAsync(markAsUsed=false)
alt OTP không hợp lệ
  AC --> FE: 400 "OTP không hợp lệ hoặc đã hết hạn."
else OTP hợp lệ
  AC -> AS: GetUserByEmailAsync(email)
  AC -> AS: ChangePasswordAsync(user, newPassword)
  AS -> DB: Update PasswordHash
  AC -> OS: MarkOtpAsUsedAsync
  OS -> DB: Update Used=true
  AC --> FE: 200 "Đổi mật khẩu thành công."
end
end
@enduml
